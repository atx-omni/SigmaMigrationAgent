{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omni-migration-agent/contracts/evidence-bundle.v1.schema.json",
  "title": "Immutable source evidence bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "bundle_id",
    "run_id",
    "scope_id",
    "created_at",
    "entries",
    "coverage_ledger_ref",
    "bundle_hash",
    "immutable",
    "security"
  ],
  "properties": {
    "contract_version": { "const": "domo-to-omni.evidence-bundle.v1" },
    "bundle_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "run_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "scope_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceEntry" }
    },
    "coverage_ledger_ref": {
      "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
    },
    "bundle_hash": {
      "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
    },
    "immutable": { "const": true },
    "security": {
      "$ref": "common-definitions.v1.schema.json#/$defs/securityMetadata"
    }
  },
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "object",
        "evidence_kind",
        "evidence_state",
        "channel",
        "media_type",
        "content_ref",
        "content_hash",
        "byte_size",
        "captured_at",
        "provenance",
        "security"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
        },
        "object": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sourceObjectRef"
        },
        "evidence_kind": {
          "enum": [
            "inventory_metadata",
            "definition",
            "schema",
            "lineage",
            "security_configuration",
            "schedule_configuration",
            "query_fixture",
            "result_fixture",
            "visual_capture",
            "interaction_capture",
            "manual_attestation"
          ]
        },
        "evidence_state": {
          "$ref": "common-definitions.v1.schema.json#/$defs/evidenceState"
        },
        "channel": {
          "$ref": "common-definitions.v1.schema.json#/$defs/acquisitionChannel"
        },
        "media_type": {
          "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
        },
        "content_ref": {
          "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
        },
        "content_hash": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
        },
        "byte_size": { "type": "integer", "minimum": 0 },
        "captured_at": { "type": "string", "format": "date-time" },
        "provenance": {
          "$ref": "common-definitions.v1.schema.json#/$defs/provenance"
        },
        "security": {
          "$ref": "common-definitions.v1.schema.json#/$defs/securityMetadata"
        }
      }
    }
  }
}
