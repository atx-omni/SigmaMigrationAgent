{
  "$defs": {
    "ArtifactInput": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_hash"
      ],
      "title": "ArtifactInput",
      "type": "object"
    },
    "CapabilityAssessment": {
      "additionalProperties": false,
      "properties": {
        "blocks_full_adapter": {
          "title": "Blocks Full Adapter",
          "type": "boolean"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "documentation_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Documentation Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/FallbackPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_properties": {
          "items": {
            "type": "string"
          },
          "title": "Missing Properties",
          "type": "array"
        },
        "object_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Object Types",
          "type": "array"
        },
        "observed_shape_paths": {
          "items": {
            "type": "string"
          },
          "title": "Observed Shape Paths",
          "type": "array"
        },
        "property_names": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Property Names",
          "type": "array"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified_full",
            "verified_partial",
            "manual_required",
            "unavailable",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "object_types",
        "property_names",
        "status",
        "evidence_refs",
        "documentation_refs",
        "observed_shape_paths",
        "missing_properties",
        "fallback",
        "blocks_full_adapter",
        "rationale"
      ],
      "title": "CapabilityAssessment",
      "type": "object"
    },
    "CapabilityMatrixPayload": {
      "additionalProperties": false,
      "properties": {
        "assessments": {
          "items": {
            "$ref": "#/$defs/CapabilityAssessment"
          },
          "title": "Assessments",
          "type": "array"
        },
        "blocking_capability_ids": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Capability Ids",
          "type": "array"
        },
        "data_model_id": {
          "title": "Data Model Id",
          "type": "string"
        },
        "deprecated_surfaces_encountered": {
          "items": {
            "type": "string"
          },
          "title": "Deprecated Surfaces Encountered",
          "type": "array"
        },
        "human_approval_required": {
          "const": true,
          "default": true,
          "title": "Human Approval Required",
          "type": "boolean"
        },
        "live_tenant_evidence": {
          "title": "Live Tenant Evidence",
          "type": "boolean"
        },
        "manual_fallback_capability_ids": {
          "items": {
            "type": "string"
          },
          "title": "Manual Fallback Capability Ids",
          "type": "array"
        },
        "matrix_status": {
          "enum": [
            "ready_for_human_review",
            "blocked"
          ],
          "title": "Matrix Status",
          "type": "string"
        },
        "source_adapter_build_authorized": {
          "const": false,
          "default": false,
          "title": "Source Adapter Build Authorized",
          "type": "boolean"
        },
        "workbook_id": {
          "title": "Workbook Id",
          "type": "string"
        }
      },
      "required": [
        "workbook_id",
        "data_model_id",
        "assessments",
        "matrix_status",
        "blocking_capability_ids",
        "manual_fallback_capability_ids",
        "deprecated_surfaces_encountered",
        "live_tenant_evidence"
      ],
      "title": "CapabilityMatrixPayload",
      "type": "object"
    },
    "FallbackPlan": {
      "additionalProperties": false,
      "properties": {
        "acceptance_test": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Acceptance Test",
          "type": "string"
        },
        "approval_ref": {
          "const": null,
          "default": null,
          "title": "Approval Ref",
          "type": "null"
        },
        "approval_state": {
          "const": "proposed",
          "default": "proposed",
          "title": "Approval State",
          "type": "string"
        },
        "method": {
          "enum": [
            "customer_operated_export",
            "version_bound_render",
            "structured_owner_manifest",
            "host_application_manifest",
            "persona_test",
            "explicit_unsupported_disposition"
          ],
          "title": "Method",
          "type": "string"
        },
        "owner_ref": {
          "title": "Owner Ref",
          "type": "string"
        }
      },
      "required": [
        "method",
        "owner_ref",
        "acceptance_test"
      ],
      "title": "FallbackPlan",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "classification": {
      "enum": [
        "documented_fact",
        "stated_evidence",
        "observed_tenant_behavior",
        "field_pattern",
        "assumption",
        "recommendation",
        "unresolved_gap",
        "synthetic_fixture"
      ],
      "title": "Classification",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "payload": {
      "$ref": "#/$defs/CapabilityMatrixPayload"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sigma-api-capability-matrix.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_id": {
      "title": "Scope Id",
      "type": "string"
    },
    "source_references": {
      "items": {
        "type": "string"
      },
      "title": "Source References",
      "type": "array"
    },
    "superseded_by_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By Artifact Id"
    },
    "supersedes_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Artifact Id"
    },
    "supersession_state": {
      "default": "current",
      "enum": [
        "current",
        "superseded"
      ],
      "title": "Supersession State",
      "type": "string"
    },
    "upstream_hashes": {
      "items": {
        "$ref": "#/$defs/ArtifactInput"
      },
      "title": "Upstream Hashes",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "run_id",
    "scope_id",
    "created_at",
    "producer",
    "source_references",
    "upstream_hashes",
    "content_hash",
    "classification",
    "schema_version",
    "payload"
  ],
  "title": "SigmaCapabilityMatrixArtifact",
  "type": "object"
}
