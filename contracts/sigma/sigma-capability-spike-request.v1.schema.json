{
  "$defs": {
    "ApprovedExclusion": {
      "additionalProperties": false,
      "properties": {
        "approval_ref": {
          "title": "Approval Ref",
          "type": "string"
        },
        "approved_by_ref": {
          "title": "Approved By Ref",
          "type": "string"
        },
        "property_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "property_id",
        "reason",
        "approved_by_ref",
        "approval_ref"
      ],
      "title": "ApprovedExclusion",
      "type": "object"
    },
    "SourceFreeze": {
      "additionalProperties": false,
      "properties": {
        "approval_ref": {
          "title": "Approval Ref",
          "type": "string"
        },
        "approved_by_ref": {
          "title": "Approved By Ref",
          "type": "string"
        },
        "data_model_document_version": {
          "minimum": 1,
          "title": "Data Model Document Version",
          "type": "integer"
        },
        "source_reference": {
          "title": "Source Reference",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "published_version",
            "version_tag",
            "documented_alternative"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "workbook_published_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workbook Published Version"
        },
        "workbook_tag_name": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "pattern": "^[^/\\\\?#%\\x00-\\x1f\\x7f]+$",
          "title": "Workbook Tag Name"
        }
      },
      "required": [
        "strategy",
        "source_reference",
        "data_model_document_version",
        "approved_by_ref",
        "approval_ref"
      ],
      "title": "SourceFreeze",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_base_url": {
      "format": "uri",
      "pattern": "^https://",
      "title": "Api Base Url",
      "type": "string"
    },
    "approved_api_hosts": {
      "items": {
        "maxLength": 253,
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Approved Api Hosts",
      "type": "array"
    },
    "approved_exclusions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ApprovedExclusion"
      },
      "title": "Approved Exclusions",
      "type": "array"
    },
    "authorization_ref": {
      "title": "Authorization Ref",
      "type": "string"
    },
    "build_scope_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Build Scope Refs",
      "type": "array"
    },
    "comparison_scope_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Comparison Scope Refs",
      "type": "array"
    },
    "credential_ref": {
      "pattern": "^secret-ref://\\S+$",
      "title": "Credential Ref",
      "type": "string"
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Data Classification",
      "type": "string"
    },
    "data_model_id": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._~-]{0,511}$",
      "title": "Data Model Id",
      "type": "string"
    },
    "effective_account_type": {
      "enum": [
        "admin",
        "creator",
        "explorer",
        "viewer",
        "unknown"
      ],
      "title": "Effective Account Type",
      "type": "string"
    },
    "evidence_mode": {
      "default": "live_tenant",
      "enum": [
        "live_tenant",
        "synthetic_fixture"
      ],
      "title": "Evidence Mode",
      "type": "string"
    },
    "expected_organization_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Expected Organization Id",
      "type": "string"
    },
    "expected_user_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Expected User Id",
      "type": "string"
    },
    "manual_evidence_owner_ref": {
      "title": "Manual Evidence Owner Ref",
      "type": "string"
    },
    "organization_ref": {
      "title": "Organization Ref",
      "type": "string"
    },
    "per_endpoint_request_budget": {
      "default": 20,
      "maximum": 250,
      "minimum": 3,
      "title": "Per Endpoint Request Budget",
      "type": "integer"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "principal_ref": {
      "title": "Principal Ref",
      "type": "string"
    },
    "privacy_approval_ref": {
      "title": "Privacy Approval Ref",
      "type": "string"
    },
    "request_budget": {
      "default": 100,
      "maximum": 250,
      "minimum": 10,
      "title": "Request Budget",
      "type": "integer"
    },
    "retention_policy_ref": {
      "title": "Retention Policy Ref",
      "type": "string"
    },
    "row_data_authorized": {
      "const": false,
      "default": false,
      "title": "Row Data Authorized",
      "type": "boolean"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 3,
      "title": "Run Id",
      "type": "string"
    },
    "sanitization_policy_ref": {
      "title": "Sanitization Policy Ref",
      "type": "string"
    },
    "schema_version": {
      "const": "sigma-capability-spike-request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_approval_ref": {
      "title": "Scope Approval Ref",
      "type": "string"
    },
    "scope_id": {
      "maxLength": 160,
      "minLength": 3,
      "title": "Scope Id",
      "type": "string"
    },
    "source_freeze": {
      "$ref": "#/$defs/SourceFreeze"
    },
    "workbook_id": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._~-]{0,511}$",
      "title": "Workbook Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "scope_id",
    "organization_ref",
    "expected_organization_id",
    "api_base_url",
    "approved_api_hosts",
    "principal_ref",
    "expected_user_id",
    "effective_account_type",
    "credential_ref",
    "authorization_ref",
    "scope_approval_ref",
    "comparison_scope_refs",
    "build_scope_refs",
    "policy_version",
    "workbook_id",
    "data_model_id",
    "source_freeze",
    "manual_evidence_owner_ref",
    "privacy_approval_ref",
    "sanitization_policy_ref",
    "retention_policy_ref",
    "data_classification"
  ],
  "title": "SigmaCapabilitySpikeRequest",
  "type": "object"
}
