{
  "$defs": {
    "ArtifactInput": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_hash"
      ],
      "title": "ArtifactInput",
      "type": "object"
    },
    "BehaviorItem": {
      "additionalProperties": false,
      "properties": {
        "acceptance_test": {
          "title": "Acceptance Test",
          "type": "string"
        },
        "behavior_id": {
          "title": "Behavior Id",
          "type": "string"
        },
        "behavior_type": {
          "enum": [
            "control",
            "action",
            "input_table",
            "schedule",
            "saved_view",
            "embed",
            "layout",
            "formatting",
            "security"
          ],
          "title": "Behavior Type",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "observed",
            "partial",
            "manual_capture_required",
            "external_redesign_required"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "owner_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Ref"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "behavior_id",
        "behavior_type",
        "source_ref",
        "disposition",
        "evidence_refs",
        "owner_ref",
        "acceptance_test",
        "blocking"
      ],
      "title": "BehaviorItem",
      "type": "object"
    },
    "BehaviorManifestPayload": {
      "additionalProperties": false,
      "properties": {
        "analytical_build_authorized": {
          "const": false,
          "default": false,
          "title": "Analytical Build Authorized",
          "type": "boolean"
        },
        "behaviors": {
          "items": {
            "$ref": "#/$defs/BehaviorItem"
          },
          "title": "Behaviors",
          "type": "array"
        },
        "closed_denominator": {
          "title": "Closed Denominator",
          "type": "boolean"
        },
        "unresolved_behavior_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Behavior Ids",
          "type": "array"
        },
        "workbook_id": {
          "title": "Workbook Id",
          "type": "string"
        }
      },
      "required": [
        "workbook_id",
        "behaviors",
        "closed_denominator",
        "unresolved_behavior_ids"
      ],
      "title": "BehaviorManifestPayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "classification": {
      "enum": [
        "documented_fact",
        "stated_evidence",
        "observed_tenant_behavior",
        "field_pattern",
        "assumption",
        "recommendation",
        "unresolved_gap",
        "synthetic_fixture"
      ],
      "title": "Classification",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "payload": {
      "$ref": "#/$defs/BehaviorManifestPayload"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sigma-behavior-manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_id": {
      "title": "Scope Id",
      "type": "string"
    },
    "source_references": {
      "items": {
        "type": "string"
      },
      "title": "Source References",
      "type": "array"
    },
    "superseded_by_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By Artifact Id"
    },
    "supersedes_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Artifact Id"
    },
    "supersession_state": {
      "default": "current",
      "enum": [
        "current",
        "superseded"
      ],
      "title": "Supersession State",
      "type": "string"
    },
    "upstream_hashes": {
      "items": {
        "$ref": "#/$defs/ArtifactInput"
      },
      "title": "Upstream Hashes",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "run_id",
    "scope_id",
    "created_at",
    "producer",
    "source_references",
    "upstream_hashes",
    "content_hash",
    "classification",
    "schema_version",
    "payload"
  ],
  "title": "SigmaBehaviorManifestArtifact",
  "type": "object"
}
