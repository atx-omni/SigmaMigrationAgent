{
  "$defs": {
    "ArtifactInput": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_hash"
      ],
      "title": "ArtifactInput",
      "type": "object"
    },
    "ContinuationEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kind"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "present",
        "kind"
      ],
      "title": "ContinuationEvidence",
      "type": "object"
    },
    "ObservationPayload": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "authorization_ref": {
          "title": "Authorization Ref",
          "type": "string"
        },
        "continuation": {
          "$ref": "#/$defs/ContinuationEvidence"
        },
        "declared_total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Total"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "duplicate_id_count": {
          "minimum": 0,
          "title": "Duplicate Id Count",
          "type": "integer"
        },
        "effective_account_type": {
          "title": "Effective Account Type",
          "type": "string"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "entry_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Count"
        },
        "exact_id_set_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Exact Id Set Sha256",
          "type": "string"
        },
        "exact_ids": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Exact Ids",
          "type": "object"
        },
        "json_valid": {
          "title": "Json Valid",
          "type": "boolean"
        },
        "method": {
          "const": "GET",
          "title": "Method",
          "type": "string"
        },
        "organization_ref": {
          "title": "Organization Ref",
          "type": "string"
        },
        "primary_ids": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Primary Ids",
          "type": "object"
        },
        "principal_ref": {
          "title": "Principal Ref",
          "type": "string"
        },
        "redaction_state": {
          "const": "structural_only",
          "default": "structural_only",
          "title": "Redaction State",
          "type": "string"
        },
        "request_query": {
          "additionalProperties": true,
          "title": "Request Query",
          "type": "object"
        },
        "response_body_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "response_bytes": {
          "minimum": 0,
          "title": "Response Bytes",
          "type": "integer"
        },
        "response_shape": {
          "items": {
            "$ref": "#/$defs/ShapePath"
          },
          "title": "Response Shape",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "row_data_retained": {
          "const": false,
          "default": false,
          "title": "Row Data Retained",
          "type": "boolean"
        },
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        },
        "version_context": {
          "enum": [
            "tenant_principal_binding",
            "data_model_document_version",
            "workbook_tag",
            "lifecycle_bracket",
            "bracketed_unversioned",
            "current_unversioned"
          ],
          "title": "Version Context",
          "type": "string"
        },
        "version_selector": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Version Selector",
          "type": "object"
        }
      },
      "required": [
        "organization_ref",
        "principal_ref",
        "effective_account_type",
        "authorization_ref",
        "version_context",
        "version_selector",
        "method",
        "endpoint",
        "request_query",
        "status_code",
        "attempt",
        "retryable",
        "response_body_sha256",
        "response_bytes",
        "json_valid",
        "response_shape",
        "exact_ids",
        "exact_id_set_sha256",
        "primary_ids",
        "duplicate_id_count",
        "continuation"
      ],
      "title": "ObservationPayload",
      "type": "object"
    },
    "ShapePath": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "types": {
          "items": {
            "type": "string"
          },
          "title": "Types",
          "type": "array"
        }
      },
      "required": [
        "path",
        "types"
      ],
      "title": "ShapePath",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "classification": {
      "enum": [
        "documented_fact",
        "stated_evidence",
        "observed_tenant_behavior",
        "field_pattern",
        "assumption",
        "recommendation",
        "unresolved_gap",
        "synthetic_fixture"
      ],
      "title": "Classification",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "payload": {
      "$ref": "#/$defs/ObservationPayload"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sigma-observation.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_id": {
      "title": "Scope Id",
      "type": "string"
    },
    "source_references": {
      "items": {
        "type": "string"
      },
      "title": "Source References",
      "type": "array"
    },
    "superseded_by_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By Artifact Id"
    },
    "supersedes_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Artifact Id"
    },
    "supersession_state": {
      "default": "current",
      "enum": [
        "current",
        "superseded"
      ],
      "title": "Supersession State",
      "type": "string"
    },
    "upstream_hashes": {
      "items": {
        "$ref": "#/$defs/ArtifactInput"
      },
      "title": "Upstream Hashes",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "run_id",
    "scope_id",
    "created_at",
    "producer",
    "source_references",
    "upstream_hashes",
    "content_hash",
    "classification",
    "schema_version",
    "payload"
  ],
  "title": "SigmaObservationArtifact",
  "type": "object"
}
