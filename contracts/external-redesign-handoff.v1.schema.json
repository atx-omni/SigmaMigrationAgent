{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omni-migration-agent/contracts/external-redesign-handoff.v1.schema.json",
  "title": "Domo-to-Omni external redesign handoff assignment v1",
  "description": "An immutable human-owned assignment for Domo behavior that remains outside the analytic migration. This record does not authorize execution or release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tenant_ref",
    "run_id",
    "scope_id",
    "wave_id",
    "migration_unit_id",
    "validation_cycle_id",
    "handoff_id",
    "handoff_ref",
    "capability",
    "source_objects",
    "analytic_outputs",
    "side_effect_kinds",
    "owner_ref",
    "assignment_work_package_id",
    "work_package_id",
    "accepted_decision",
    "evidence_refs",
    "assignment_only",
    "authorizes_build",
    "authorizes_target_write",
    "authorizes_tenant_acceptance",
    "authorizes_production_readiness",
    "authorizes_promotion",
    "authorizes_publication",
    "authorizes_cutover",
    "authorizes_decommissioning",
    "immutable",
    "handoff_hash"
  ],
  "properties": {
    "contract_version": {
      "const": "domo-to-omni.external-redesign-handoff.v1"
    },
    "tenant_ref": {
      "allOf": [
        { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
        { "pattern": "^tenant-ref:.+$" }
      ]
    },
    "run_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "scope_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "wave_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "migration_unit_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "validation_cycle_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "handoff_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "handoff_ref": {
      "allOf": [
        { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
        { "pattern": "^handoff-ref:.+$" }
      ]
    },
    "capability": {
      "enum": [
        "platform_ingestion",
        "application_redesign",
        "operations_governance"
      ]
    },
    "source_objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exactSourceObject" }
    },
    "analytic_outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exactAnalyticOutput" }
    },
    "side_effect_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sideEffectKind" }
    },
    "owner_ref": {
      "allOf": [
        { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
        { "pattern": "^(human-ref|person-ref):.+$" }
      ]
    },
    "assignment_work_package_id": {
      "type": "string",
      "pattern": "^wp-[a-f0-9]{20}$"
    },
    "work_package_id": {
      "type": "string",
      "pattern": "^wp-[a-f0-9]{20}$"
    },
    "accepted_decision": {
      "$ref": "#/$defs/acceptedHumanDecision"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
      }
    },
    "assignment_only": { "const": true },
    "authorizes_build": { "const": false },
    "authorizes_target_write": { "const": false },
    "authorizes_tenant_acceptance": { "const": false },
    "authorizes_production_readiness": { "const": false },
    "authorizes_promotion": { "const": false },
    "authorizes_publication": { "const": false },
    "authorizes_cutover": { "const": false },
    "authorizes_decommissioning": { "const": false },
    "immutable": { "const": true },
    "handoff_hash": {
      "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "exactSourceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "object_type", "native_id", "object_hash"],
      "properties": {
        "object_id": {
          "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
        },
        "object_type": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sourceObjectType"
        },
        "native_id": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sourceNativeId"
        },
        "object_hash": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "exactAnalyticOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "object_type", "native_id", "object_hash"],
      "properties": {
        "object_id": {
          "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
        },
        "object_type": { "const": "dataset" },
        "native_id": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sourceNativeId"
        },
        "object_hash": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "sideEffectKind": {
      "enum": [
        "external_write",
        "message_delivery",
        "recipient_delivery",
        "code_execution",
        "credential_use",
        "form_submission",
        "embed_identity"
      ]
    },
    "acceptedHumanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision_ref", "accepted_by_ref", "accepted_at"],
      "properties": {
        "status": { "const": "accepted" },
        "decision_ref": {
          "allOf": [
            { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
            { "pattern": "^decision-ref:.+$" }
          ]
        },
        "accepted_by_ref": {
          "allOf": [
            { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
            { "pattern": "^(human-ref|person-ref):.+$" }
          ]
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
