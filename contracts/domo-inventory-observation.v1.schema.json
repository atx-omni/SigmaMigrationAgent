{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omni-migration-agent/contracts/domo-inventory-observation.v1.schema.json",
  "title": "Immutable Domo inventory channel observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "observation_id",
    "run_id",
    "scope_id",
    "source_tenant_ref",
    "visibility_principal_ref",
    "capability_id",
    "observation_kind",
    "channel",
    "observed_at",
    "authority",
    "request_context",
    "pagination",
    "totals",
    "observed_objects",
    "exact_id_set_hash",
    "exclusions",
    "diagnostics",
    "completeness",
    "denominator_eligible",
    "observation_hash",
    "immutable",
    "provenance",
    "security"
  ],
  "properties": {
    "contract_version": { "const": "domo-to-omni.inventory-observation.v1" },
    "observation_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "run_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "scope_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "source_tenant_ref": {
      "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
    },
    "visibility_principal_ref": {
      "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
    },
    "capability_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "observation_kind": {
      "enum": [
        "platform_list",
        "product_search",
        "detail_hydration",
        "domostats_report",
        "governance_report",
        "customer_export",
        "manual_manifest"
      ]
    },
    "channel": {
      "$ref": "common-definitions.v1.schema.json#/$defs/acquisitionChannel"
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility_principal_ref",
        "authorization_ref",
        "read_only"
      ],
      "properties": {
        "visibility_principal_ref": {
          "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
        },
        "authorization_ref": {
          "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
        },
        "read_only": { "const": true }
      }
    },
    "request_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "filters_hash",
        "window",
        "report_generated_at"
      ],
      "properties": {
        "source_ref": {
          "oneOf": [
            { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
            { "type": "null" }
          ]
        },
        "filters_hash": {
          "oneOf": [
            { "$ref": "common-definitions.v1.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "window": {
          "oneOf": [
            { "$ref": "#/$defs/timeWindow" },
            { "type": "null" }
          ]
        },
        "report_generated_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "page_count",
        "request_count",
        "exhausted",
        "truncated",
        "ceiling_reached",
        "next_offset",
        "checkpoint_ref",
        "checkpoint_hash",
        "endpoint",
        "seen_ids",
        "seen_id_set_hash",
        "expected_total",
        "warnings"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "cursor",
            "offset_limit",
            "page_number",
            "bounded_search",
            "single_document",
            "not_applicable",
            "unknown"
          ]
        },
        "page_count": { "type": "integer", "minimum": 0 },
        "request_count": { "type": "integer", "minimum": 0 },
        "exhausted": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "ceiling_reached": { "type": "boolean" },
        "next_offset": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "checkpoint_ref": {
          "$ref": "common-definitions.v1.schema.json#/$defs/nullableNonSecretRef"
        },
        "checkpoint_hash": {
          "oneOf": [
            { "$ref": "common-definitions.v1.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "endpoint": {
          "oneOf": [
            {
              "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
            },
            { "type": "null" }
          ]
        },
        "seen_ids": {
          "type": "array",
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/sourceNativeId"
          }
        },
        "seen_id_set_hash": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
        },
        "expected_total": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_count",
        "provider_total",
        "duplicate_count",
        "denied_count",
        "failed_count",
        "excluded_count"
      ],
      "properties": {
        "observed_count": { "type": "integer", "minimum": 0 },
        "provider_total": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "duplicate_count": { "type": "integer", "minimum": 0 },
        "denied_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "excluded_count": { "type": "integer", "minimum": 0 }
      }
    },
    "observed_objects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common-definitions.v1.schema.json#/$defs/sourceObjectRef"
      }
    },
    "exact_id_set_hash": {
      "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "count", "evidence_refs"],
        "properties": {
          "reason": {
            "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
          },
          "count": { "type": "integer", "minimum": 1 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
      }
    },
    "completeness": {
      "enum": ["complete", "partial", "blocked", "discovery_only"]
    },
    "denominator_eligible": { "type": "boolean" },
    "observation_hash": {
      "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
    },
    "immutable": { "const": true },
    "provenance": {
      "$ref": "common-definitions.v1.schema.json#/$defs/provenance"
    },
    "security": {
      "$ref": "common-definitions.v1.schema.json#/$defs/securityMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "observation_kind": { "const": "product_search" } },
        "required": ["observation_kind"]
      },
      "then": {
        "properties": {
          "completeness": { "const": "discovery_only" },
          "denominator_eligible": { "const": false },
          "pagination": {
            "properties": { "strategy": { "const": "bounded_search" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "completeness": { "const": "complete" } },
        "required": ["completeness"]
      },
      "then": {
        "properties": {
          "pagination": {
            "properties": {
              "exhausted": { "const": true },
              "truncated": { "const": false },
              "ceiling_reached": { "const": false }
            }
          },
          "totals": {
            "properties": {
              "denied_count": { "const": 0 },
              "failed_count": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "denominator_eligible": { "const": true } },
        "required": ["denominator_eligible"]
      },
      "then": {
        "properties": {
          "completeness": { "const": "complete" },
          "observation_kind": {
            "enum": ["platform_list", "domostats_report", "governance_report"]
          },
          "totals": {
            "properties": {
              "provider_total": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_kind": {
            "enum": ["domostats_report", "governance_report"]
          },
          "denominator_eligible": { "const": true }
        },
        "required": ["observation_kind", "denominator_eligible"]
      },
      "then": {
        "properties": {
          "request_context": {
            "properties": {
              "source_ref": {
                "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
              },
              "filters_hash": {
                "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
              },
              "window": { "$ref": "#/$defs/timeWindow" },
              "report_generated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_kind": { "const": "platform_list" },
          "denominator_eligible": { "const": true }
        },
        "required": ["observation_kind", "denominator_eligible"]
      },
      "then": {
        "properties": {
          "request_context": {
            "properties": {
              "source_ref": {
                "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
              },
              "filters_hash": {
                "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
              },
              "window": { "$ref": "#/$defs/timeWindow" }
            }
          },
          "pagination": {
            "properties": {
              "checkpoint_ref": {
                "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
              },
              "checkpoint_hash": {
                "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
              },
              "endpoint": {
                "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
              },
              "expected_total": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "timezone": {
          "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
        }
      }
    }
  }
}
