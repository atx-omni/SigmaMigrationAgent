{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omni-migration-agent/contracts/topic-blueprint.v1.schema.json",
  "title": "Immutable proposal-only Omni Topic blueprint",
  "description": "A source-traceable Topic design proposal. Readiness is validated against independent current decision and fanout acceptance evidence; this artifact never authorizes a build.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "blueprint_id",
    "run_id",
    "scope_id",
    "business_domain_id",
    "topic_name",
    "topic_description",
    "business_use_case",
    "audience",
    "decision_bindings",
    "profile_bindings",
    "validation_context",
    "base_fact",
    "views",
    "fields",
    "measures",
    "joins",
    "security",
    "freshness",
    "ownership",
    "source_mappings",
    "consumer_mappings",
    "logic_placements",
    "unresolved_exceptions",
    "proposal_only",
    "authorizes_build",
    "authorizes_source_decommission",
    "blueprint_hash",
    "immutable",
    "provenance",
    "security_metadata"
  ],
  "properties": {
    "contract_version": { "const": "domo-to-omni.topic-blueprint.v1" },
    "blueprint_id": { "$ref": "#/$defs/stableId" },
    "run_id": { "$ref": "#/$defs/stableId" },
    "scope_id": { "$ref": "#/$defs/stableId" },
    "business_domain_id": { "$ref": "#/$defs/stableId" },
    "topic_name": { "$ref": "#/$defs/nonEmptyString" },
    "topic_description": { "$ref": "#/$defs/nonEmptyString" },
    "business_use_case": { "$ref": "#/$defs/businessUseCase" },
    "audience": { "$ref": "#/$defs/audience" },
    "decision_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/decisionBinding" }
    },
    "profile_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/profileBinding" }
    },
    "validation_context": { "$ref": "#/$defs/validationContext" },
    "base_fact": { "$ref": "#/$defs/baseFact" },
    "views": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/view" }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/field" }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/measure" }
    },
    "joins": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/join" }
    },
    "security": { "$ref": "#/$defs/security" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "ownership": { "$ref": "#/$defs/ownership" },
    "source_mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceMapping" }
    },
    "consumer_mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/consumerMapping" }
    },
    "logic_placements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/logicPlacement" }
    },
    "unresolved_exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/unresolvedException" }
    },
    "proposal_only": { "const": true },
    "authorizes_build": { "const": false },
    "authorizes_source_decommission": { "const": false },
    "blueprint_hash": { "$ref": "#/$defs/sha256" },
    "immutable": { "const": true },
    "provenance": { "$ref": "#/$defs/provenance" },
    "security_metadata": { "$ref": "#/$defs/securityMetadata" }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonSecretRef": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?![Ss][Ee][Cc][Rr][Ee][Tt](?:-[Rr][Ee][Ff])?:|[Vv][Aa][Uu][Ll][Tt]:|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]:)[A-Za-z][A-Za-z0-9+.-]*:.+$"
    },
    "actorRef": {
      "type": "string",
      "pattern": "^(?:agent-ref|human-ref|person-ref|person):.+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "requiredStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "refList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonSecretRef" }
    },
    "requiredRefList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonSecretRef" }
    },
    "businessUseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_case_id",
        "name",
        "description",
        "business_questions",
        "success_criteria"
      ],
      "properties": {
        "use_case_id": { "$ref": "#/$defs/stableId" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "business_questions": { "$ref": "#/$defs/requiredStringList" },
        "success_criteria": { "$ref": "#/$defs/requiredStringList" }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience_id",
        "name",
        "description",
        "persona_refs",
        "access_purpose"
      ],
      "properties": {
        "audience_id": { "$ref": "#/$defs/stableId" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "persona_refs": { "$ref": "#/$defs/requiredRefList" },
        "access_purpose": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "decisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision_hash",
        "input_fingerprint",
        "validation_cycle_id",
        "group_id"
      ],
      "properties": {
        "decision_id": { "$ref": "#/$defs/stableId" },
        "decision_hash": { "$ref": "#/$defs/sha256" },
        "input_fingerprint": { "$ref": "#/$defs/sha256" },
        "validation_cycle_id": { "$ref": "#/$defs/nonEmptyString" },
        "group_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "system", "asset_id", "profile_hash"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/stableId" },
        "system": { "enum": ["domo", "dbt", "snowflake", "omni"] },
        "asset_id": { "$ref": "#/$defs/nonEmptyString" },
        "profile_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "validationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_hash", "revision"],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/nonSecretRef" },
        "artifact_hash": { "$ref": "#/$defs/sha256" },
        "revision": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "inventoryClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_hash", "revision", "status"],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/nonSecretRef" },
        "artifact_hash": { "$ref": "#/$defs/sha256" },
        "revision": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["complete", "incomplete"] }
      }
    },
    "validationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_closure",
        "source_graph",
        "portfolio_inventory",
        "repository_inventory",
        "target_context",
        "policy_bundle",
        "approval_owner_policy",
        "fixture_bundle",
        "consumer_contract_set",
        "context_hash"
      ],
      "properties": {
        "inventory_closure": { "$ref": "#/$defs/inventoryClosure" },
        "source_graph": { "$ref": "#/$defs/validationArtifact" },
        "portfolio_inventory": { "$ref": "#/$defs/validationArtifact" },
        "repository_inventory": { "$ref": "#/$defs/validationArtifact" },
        "target_context": { "$ref": "#/$defs/validationArtifact" },
        "policy_bundle": { "$ref": "#/$defs/validationArtifact" },
        "approval_owner_policy": { "$ref": "#/$defs/validationArtifact" },
        "fixture_bundle": { "$ref": "#/$defs/validationArtifact" },
        "consumer_contract_set": { "$ref": "#/$defs/validationArtifact" },
        "context_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "baseFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "profile_id",
        "grain",
        "primary_key_fields",
        "uniqueness_evidence_refs"
      ],
      "properties": {
        "view_id": { "$ref": "#/$defs/stableId" },
        "profile_id": { "$ref": "#/$defs/stableId" },
        "grain": { "$ref": "#/$defs/nonEmptyString" },
        "primary_key_fields": { "$ref": "#/$defs/requiredStringList" },
        "uniqueness_evidence_refs": { "$ref": "#/$defs/requiredRefList" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "profile_id",
        "role",
        "label",
        "description",
        "grain",
        "primary_key_fields",
        "key_evidence_refs"
      ],
      "properties": {
        "view_id": { "$ref": "#/$defs/stableId" },
        "profile_id": { "$ref": "#/$defs/stableId" },
        "role": { "enum": ["base_fact", "dimension", "bridge"] },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "grain": { "$ref": "#/$defs/nonEmptyString" },
        "primary_key_fields": { "$ref": "#/$defs/requiredStringList" },
        "key_evidence_refs": { "$ref": "#/$defs/requiredRefList" },
        "grain_key_exception": { "$ref": "#/$defs/nullableApprovedException" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "view_id",
        "source_field",
        "label",
        "description",
        "data_type",
        "field_kind",
        "nullable",
        "source_mapping_refs"
      ],
      "properties": {
        "field_id": { "$ref": "#/$defs/stableId" },
        "view_id": { "$ref": "#/$defs/stableId" },
        "source_field": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "data_type": { "$ref": "#/$defs/nonEmptyString" },
        "field_kind": {
          "enum": ["identifier", "dimension", "time_dimension", "attribute"]
        },
        "nullable": { "type": "boolean" },
        "source_mapping_refs": { "$ref": "#/$defs/requiredStringList" }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measure_id",
        "view_id",
        "label",
        "description",
        "expression",
        "aggregation",
        "grain",
        "logic_placement_id",
        "source_mapping_refs"
      ],
      "properties": {
        "measure_id": { "$ref": "#/$defs/stableId" },
        "view_id": { "$ref": "#/$defs/stableId" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "expression": { "$ref": "#/$defs/nonEmptyString" },
        "aggregation": {
          "enum": [
            "sum",
            "count",
            "count_distinct",
            "average",
            "minimum",
            "maximum",
            "custom"
          ]
        },
        "grain": { "$ref": "#/$defs/nonEmptyString" },
        "logic_placement_id": { "$ref": "#/$defs/stableId" },
        "source_mapping_refs": { "$ref": "#/$defs/requiredStringList" }
      }
    },
    "joinPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_field_id", "operator", "right_field_id"],
      "properties": {
        "left_field_id": { "$ref": "#/$defs/stableId" },
        "operator": { "const": "=" },
        "right_field_id": { "$ref": "#/$defs/stableId" }
      }
    },
    "fanoutTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fixture_ref",
        "result_ref",
        "result_hash",
        "accepted_result_ref",
        "evidence_refs"
      ],
      "properties": {
        "status": { "const": "passed" },
        "fixture_ref": { "$ref": "#/$defs/nonSecretRef" },
        "result_ref": { "$ref": "#/$defs/nonSecretRef" },
        "result_hash": { "$ref": "#/$defs/sha256" },
        "accepted_result_ref": { "$ref": "#/$defs/nonSecretRef" },
        "evidence_refs": { "$ref": "#/$defs/requiredRefList" }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "join_id",
        "left_view_id",
        "right_view_id",
        "predicates",
        "relationship_type",
        "left_key_fields",
        "right_key_fields",
        "fanout_test",
        "evidence_refs"
      ],
      "properties": {
        "join_id": { "$ref": "#/$defs/stableId" },
        "left_view_id": { "$ref": "#/$defs/stableId" },
        "right_view_id": { "$ref": "#/$defs/stableId" },
        "predicates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/joinPredicate" }
        },
        "relationship_type": {
          "enum": ["one_to_one", "one_to_many", "many_to_one"]
        },
        "left_key_fields": { "$ref": "#/$defs/requiredStringList" },
        "right_key_fields": { "$ref": "#/$defs/requiredStringList" },
        "fanout_test": { "$ref": "#/$defs/fanoutTest" },
        "evidence_refs": { "$ref": "#/$defs/requiredRefList" }
      }
    },
    "approvedException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_id",
        "decision_ref",
        "decision_hash",
        "approval_ref",
        "rationale"
      ],
      "properties": {
        "exception_id": { "$ref": "#/$defs/stableId" },
        "decision_ref": { "$ref": "#/$defs/nonSecretRef" },
        "decision_hash": { "$ref": "#/$defs/sha256" },
        "approval_ref": { "$ref": "#/$defs/nonSecretRef" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "nullableApprovedException": {
      "oneOf": [
        { "$ref": "#/$defs/approvedException" },
        { "type": "null" }
      ]
    },
    "logicPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement_id",
        "logic_kind",
        "target_layer",
        "target_artifact_ref",
        "source_mapping_refs",
        "rationale",
        "approved_exception"
      ],
      "properties": {
        "placement_id": { "$ref": "#/$defs/stableId" },
        "logic_kind": {
          "enum": [
            "persistent_transformation",
            "shared_transformation",
            "expensive_transformation",
            "cross_consumer_transformation",
            "presentation",
            "exploration",
            "drill",
            "labeling",
            "audience_semantics"
          ]
        },
        "target_layer": { "enum": ["dbt", "snowflake", "omni"] },
        "target_artifact_ref": { "$ref": "#/$defs/nonSecretRef" },
        "source_mapping_refs": { "$ref": "#/$defs/requiredStringList" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "approved_exception": { "$ref": "#/$defs/nullableApprovedException" }
      }
    },
    "personaExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona_ref",
        "access",
        "scope_ref",
        "derived_field_access",
        "evidence_refs"
      ],
      "properties": {
        "persona_ref": { "$ref": "#/$defs/nonSecretRef" },
        "access": { "enum": ["allowed", "denied"] },
        "scope_ref": { "$ref": "#/$defs/nonSecretRef" },
        "derived_field_access": {
          "enum": ["visible", "masked", "hidden", "not_applicable"]
        },
        "evidence_refs": { "$ref": "#/$defs/requiredRefList" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_security_domains",
        "target_security_domain",
        "persona_refs",
        "persona_expectations",
        "source_policy_refs",
        "target_policy_refs",
        "principal_precedence",
        "derived_field_exposure",
        "boundary_disposition",
        "separate_topic_refs",
        "approved_secure_design",
        "persona_scope_exception",
        "evidence_refs"
      ],
      "properties": {
        "source_security_domains": { "$ref": "#/$defs/requiredStringList" },
        "target_security_domain": { "$ref": "#/$defs/nonEmptyString" },
        "persona_refs": { "$ref": "#/$defs/requiredRefList" },
        "persona_expectations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/personaExpectation" }
        },
        "source_policy_refs": { "$ref": "#/$defs/refList" },
        "target_policy_refs": { "$ref": "#/$defs/refList" },
        "principal_precedence": { "$ref": "#/$defs/stringList" },
        "derived_field_exposure": { "const": "safe" },
        "boundary_disposition": {
          "enum": ["single_domain", "separate_topics", "approved_secure_design"]
        },
        "separate_topic_refs": { "$ref": "#/$defs/refList" },
        "approved_secure_design": { "$ref": "#/$defs/nullableApprovedException" },
        "persona_scope_exception": { "$ref": "#/$defs/nullableApprovedException" },
        "evidence_refs": { "$ref": "#/$defs/requiredRefList" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "boundary_disposition": { "const": "single_domain" } },
            "required": ["boundary_disposition"]
          },
          "then": {
            "properties": {
              "separate_topic_refs": { "maxItems": 0 },
              "approved_secure_design": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "boundary_disposition": { "const": "separate_topics" } },
            "required": ["boundary_disposition"]
          },
          "then": {
            "properties": {
              "separate_topic_refs": { "minItems": 1 },
              "approved_secure_design": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "boundary_disposition": { "const": "approved_secure_design" }
            },
            "required": ["boundary_disposition"]
          },
          "then": {
            "properties": {
              "separate_topic_refs": { "maxItems": 0 },
              "approved_secure_design": { "$ref": "#/$defs/approvedException" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_security_domains": { "const": ["unrestricted"] },
              "target_security_domain": { "const": "unrestricted" }
            },
            "required": ["source_security_domains", "target_security_domain"]
          },
          "then": {
            "properties": {
              "source_policy_refs": { "maxItems": 0 },
              "target_policy_refs": { "maxItems": 0 },
              "principal_precedence": { "maxItems": 0 },
              "persona_expectations": {
                "items": {
                  "properties": {
                    "access": { "const": "allowed" },
                    "derived_field_access": { "const": "not_applicable" }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "target_policy_refs": { "minItems": 1 },
              "principal_precedence": { "minItems": 1 },
              "persona_expectations": {
                "allOf": [
                  {
                    "contains": {
                      "properties": { "access": { "const": "allowed" } },
                      "required": ["access"]
                    },
                    "minContains": 1
                  },
                  {
                    "contains": {
                      "properties": { "access": { "const": "denied" } },
                      "required": ["access"]
                    },
                    "minContains": 1
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_mode",
        "watermark_field",
        "freshness_sla",
        "history_behavior",
        "backfill_behavior",
        "owner_refs",
        "sla_ref",
        "evidence_refs"
      ],
      "properties": {
        "update_mode": { "enum": ["replace", "append", "upsert", "snapshot", "view"] },
        "watermark_field": { "type": ["string", "null"] },
        "freshness_sla": { "$ref": "#/$defs/nonEmptyString" },
        "history_behavior": { "$ref": "#/$defs/nonEmptyString" },
        "backfill_behavior": { "$ref": "#/$defs/nonEmptyString" },
        "owner_refs": { "$ref": "#/$defs/requiredRefList" },
        "sla_ref": { "$ref": "#/$defs/nonSecretRef" },
        "evidence_refs": { "$ref": "#/$defs/requiredRefList" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_owner_refs",
        "technical_owner_refs",
        "security_owner_refs",
        "operations_owner_refs"
      ],
      "properties": {
        "business_owner_refs": { "$ref": "#/$defs/requiredRefList" },
        "technical_owner_refs": { "$ref": "#/$defs/requiredRefList" },
        "security_owner_refs": { "$ref": "#/$defs/requiredRefList" },
        "operations_owner_refs": { "$ref": "#/$defs/requiredRefList" }
      }
    },
    "sourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id",
        "source_profile_id",
        "source_profile_hash",
        "source_asset_id",
        "source_component_ref",
        "target_kind",
        "target_id",
        "decision_id",
        "transformation",
        "evidence_refs"
      ],
      "properties": {
        "mapping_id": { "$ref": "#/$defs/stableId" },
        "source_profile_id": { "$ref": "#/$defs/stableId" },
        "source_profile_hash": { "$ref": "#/$defs/sha256" },
        "source_asset_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_component_ref": { "$ref": "#/$defs/nonSecretRef" },
        "target_kind": { "enum": ["view", "field", "measure", "logic"] },
        "target_id": { "$ref": "#/$defs/stableId" },
        "decision_id": { "$ref": "#/$defs/stableId" },
        "transformation": {
          "enum": ["reused", "translated", "consolidated", "parameterized", "redesigned"]
        },
        "evidence_refs": { "$ref": "#/$defs/requiredRefList" }
      }
    },
    "consumerDecisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "behavior",
        "accepted_difference_ref"
      ],
      "properties": {
        "decision_id": { "$ref": "#/$defs/stableId" },
        "behavior": { "enum": ["preserved", "approved_change"] },
        "accepted_difference_ref": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "behavior": { "const": "preserved" } },
            "required": ["behavior"]
          },
          "then": { "properties": { "accepted_difference_ref": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "behavior": { "const": "approved_change" } },
            "required": ["behavior"]
          },
          "then": {
            "properties": {
              "accepted_difference_ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "consumerMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_consumer_id",
        "target_consumer_ref",
        "topic_component_refs",
        "decision_bindings"
      ],
      "properties": {
        "source_consumer_id": { "$ref": "#/$defs/nonEmptyString" },
        "target_consumer_ref": { "$ref": "#/$defs/nonSecretRef" },
        "topic_component_refs": { "$ref": "#/$defs/requiredStringList" },
        "decision_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/consumerDecisionBinding" }
        }
      }
    },
    "unresolvedException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_id",
        "category",
        "description",
        "owner_ref",
        "handoff_ref",
        "blocks_readiness"
      ],
      "properties": {
        "exception_id": { "$ref": "#/$defs/stableId" },
        "category": {
          "enum": [
            "grain",
            "join",
            "security",
            "freshness",
            "ownership",
            "logic_placement",
            "consumer_behavior",
            "other"
          ]
        },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "owner_ref": { "$ref": "#/$defs/actorRef" },
        "handoff_ref": { "$ref": "#/$defs/nonSecretRef" },
        "blocks_readiness": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_ref", "source_refs", "evidence_refs"],
      "properties": {
        "producer_ref": { "$ref": "#/$defs/actorRef" },
        "source_refs": { "$ref": "#/$defs/requiredRefList" },
        "evidence_refs": { "$ref": "#/$defs/requiredRefList" }
      }
    },
    "securityMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": { "enum": ["internal", "confidential", "restricted"] }
      }
    }
  }
}
