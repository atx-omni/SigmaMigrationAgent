{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omni-migration-agent/contracts/inventory-snapshot.v1.schema.json",
  "title": "Immutable Domo migration inventory snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "snapshot_id",
    "run_id",
    "scope_id",
    "as_of",
    "preflight_ref",
    "source_object_graph_ref",
    "coverage_ledger_ref",
    "evidence_bundle_ref",
    "reconciliations",
    "object_counts",
    "completion",
    "source_fingerprint",
    "immutable",
    "provenance",
    "security"
  ],
  "properties": {
    "contract_version": { "const": "domo-to-omni.inventory-snapshot.v1" },
    "snapshot_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "run_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "scope_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "as_of": { "type": "string", "format": "date-time" },
    "preflight_ref": {
      "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
    },
    "source_object_graph_ref": {
      "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
    },
    "coverage_ledger_ref": {
      "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
    },
    "evidence_bundle_ref": {
      "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
    },
    "reconciliations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "status", "observed_count", "difference_count", "evidence_refs"],
        "properties": {
          "channel": {
            "$ref": "common-definitions.v1.schema.json#/$defs/acquisitionChannel"
          },
          "status": { "enum": ["reconciled", "difference_explained", "difference_unresolved", "not_available"] },
          "observed_count": { "type": "integer", "minimum": 0 },
          "difference_count": { "type": "integer", "minimum": 0 },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
            }
          }
        }
      }
    },
    "object_counts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_type", "total", "complete", "partial", "metadata_only", "manual_required", "blocked"],
        "properties": {
          "object_type": {
            "$ref": "common-definitions.v1.schema.json#/$defs/sourceObjectType"
          },
          "total": { "type": "integer", "minimum": 0 },
          "complete": { "type": "integer", "minimum": 0 },
          "partial": { "type": "integer", "minimum": 0 },
          "metadata_only": { "type": "integer", "minimum": 0 },
          "manual_required": { "type": "integer", "minimum": 0 },
          "blocked": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "dependency_closure", "coverage_state", "unresolved_object_ids", "manual_capture_request_refs"],
      "properties": {
        "state": { "enum": ["draft", "complete", "partial", "blocked"] },
        "dependency_closure": { "enum": ["complete", "partial", "blocked"] },
        "coverage_state": { "enum": ["complete", "partial", "blocked"] },
        "unresolved_object_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
          }
        },
        "manual_capture_request_refs": {
          "type": "array",
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "complete" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "dependency_closure": { "const": "complete" },
              "coverage_state": { "const": "complete" },
              "unresolved_object_ids": { "maxItems": 0 },
              "manual_capture_request_refs": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "source_fingerprint": {
      "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
    },
    "immutable": { "const": true },
    "provenance": {
      "$ref": "common-definitions.v1.schema.json#/$defs/provenance"
    },
    "security": {
      "$ref": "common-definitions.v1.schema.json#/$defs/securityMetadata"
    }
  }
}
