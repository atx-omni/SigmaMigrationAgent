{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omni-migration-agent/contracts/manual-capture-request.v1.schema.json",
  "title": "Manual Domo evidence capture request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "run_id",
    "scope_id",
    "object",
    "missing_facets",
    "reason",
    "instructions",
    "accepted_formats",
    "prohibited_content",
    "requested_from_ref",
    "requested_at",
    "priority",
    "status",
    "resolution",
    "security"
  ],
  "properties": {
    "contract_version": { "const": "domo-to-omni.manual-capture-request.v1" },
    "request_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "run_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "scope_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "object": {
      "$ref": "common-definitions.v1.schema.json#/$defs/sourceObjectRef"
    },
    "missing_facets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "definition",
          "schema",
          "lineage",
          "formula",
          "filter_context",
          "visual_formatting",
          "interaction_behavior",
          "security_behavior",
          "schedule_behavior",
          "application_behavior",
          "result_fixture"
        ]
      }
    },
    "reason": {
      "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
      }
    },
    "accepted_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["json", "csv", "sql", "zip", "png", "pdf", "screen_recording", "written_attestation"]
      }
    },
    "prohibited_content": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "credentials" },
      "items": {
        "enum": ["credentials", "access_tokens", "unredacted_restricted_rows", "unapproved_personal_data"]
      }
    },
    "requested_from_ref": {
      "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
    },
    "requested_at": { "type": "string", "format": "date-time" },
    "priority": { "enum": ["low", "normal", "high", "blocking"] },
    "status": { "enum": ["open", "in_progress", "completed", "declined", "superseded"] },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_at", "evidence_refs", "resolution_note", "resolved_by_ref"],
      "properties": {
        "resolved_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
          }
        },
        "resolution_note": {
          "oneOf": [
            { "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "resolved_by_ref": {
          "$ref": "common-definitions.v1.schema.json#/$defs/nullableNonSecretRef"
        }
      }
    },
    "security": {
      "$ref": "common-definitions.v1.schema.json#/$defs/securityMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolution": {
            "properties": {
              "resolved_at": { "type": "string", "format": "date-time" },
              "evidence_refs": { "minItems": 1 },
              "resolution_note": {
                "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
              },
              "resolved_by_ref": {
                "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["open", "in_progress"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolution": {
            "properties": {
              "resolved_at": { "type": "null" },
              "evidence_refs": { "maxItems": 0 },
              "resolved_by_ref": { "type": "null" }
            }
          }
        }
      }
    }
  ]
}
