{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omni-migration-agent/contracts/source-object-graph.v1.schema.json",
  "title": "Versioned Domo source object and dependency graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "graph_id",
    "run_id",
    "scope_id",
    "generated_at",
    "objects",
    "edges",
    "closure",
    "graph_hash",
    "provenance",
    "security"
  ],
  "properties": {
    "contract_version": { "const": "domo-to-omni.source-object-graph.v1" },
    "graph_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "run_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "scope_id": {
      "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceObject" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependencyEdge" }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_object_ids",
        "status",
        "captured_all_reachable",
        "unresolved_object_ids",
        "unresolved_reasons"
      ],
      "properties": {
        "entry_object_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
          }
        },
        "status": { "enum": ["complete", "partial", "blocked"] },
        "captured_all_reachable": { "type": "boolean" },
        "unresolved_object_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
          }
        },
        "unresolved_reasons": {
          "type": "array",
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "complete" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "captured_all_reachable": { "const": true },
              "unresolved_object_ids": { "maxItems": 0 },
              "unresolved_reasons": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["partial", "blocked"] } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "captured_all_reachable": { "const": false },
              "unresolved_reasons": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "graph_hash": {
      "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
    },
    "provenance": {
      "$ref": "common-definitions.v1.schema.json#/$defs/provenance"
    },
    "security": {
      "$ref": "common-definitions.v1.schema.json#/$defs/securityMetadata"
    }
  },
  "$defs": {
    "sourceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "name",
        "lifecycle_state",
        "evidence_state",
        "source_version",
        "metadata_hash",
        "definition_hash",
        "last_modified_at",
        "owner_refs",
        "evidence_refs",
        "security",
        "provenance"
      ],
      "properties": {
        "identity": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sourceObjectRef"
        },
        "name": {
          "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString"
        },
        "lifecycle_state": { "enum": ["active", "inactive", "deleted", "unknown"] },
        "evidence_state": {
          "$ref": "common-definitions.v1.schema.json#/$defs/evidenceState"
        },
        "source_version": {
          "oneOf": [
            { "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "metadata_hash": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
        },
        "definition_hash": {
          "oneOf": [
            { "$ref": "common-definitions.v1.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "last_modified_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "owner_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
          }
        },
        "security": {
          "$ref": "common-definitions.v1.schema.json#/$defs/securityMetadata"
        },
        "provenance": {
          "$ref": "common-definitions.v1.schema.json#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidence_state": { "const": "extracted_complete" } },
            "required": ["evidence_state"]
          },
          "then": {
            "properties": {
              "definition_hash": {
                "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
              },
              "evidence_refs": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "from_object_id",
        "to_object_id",
        "relationship",
        "confidence",
        "evidence_refs",
        "edge_hash"
      ],
      "properties": {
        "edge_id": {
          "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
        },
        "from_object_id": {
          "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
        },
        "to_object_id": {
          "$ref": "common-definitions.v1.schema.json#/$defs/stableId"
        },
        "relationship": {
          "enum": [
            "contains",
            "powered_by",
            "input_to",
            "output_of",
            "uses_field",
            "uses_beast_mode",
            "uses_variable",
            "secured_by",
            "scheduled_by",
            "alerts_on",
            "embeds",
            "drills_to",
            "triggers",
            "invokes",
            "owned_by",
            "derived_from"
          ]
        },
        "confidence": { "enum": ["documented", "observed", "inferred"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef"
          }
        },
        "edge_hash": {
          "$ref": "common-definitions.v1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
