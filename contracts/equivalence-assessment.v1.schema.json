{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omni-migration-agent/contracts/equivalence-assessment.v1.schema.json",
  "title": "Directional semantic equivalence assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "assessment_id",
    "run_id",
    "scope_id",
    "left_profile",
    "right_profile",
    "direction",
    "candidate_methods",
    "dimensions",
    "overall_category",
    "overall_confidence",
    "hard_vetoes",
    "consumer_scope",
    "consumer_map_hash",
    "validation_context",
    "proposal_only",
    "authorizes_consolidation",
    "assessment_hash",
    "immutable",
    "provenance",
    "security"
  ],
  "properties": {
    "contract_version": { "const": "domo-to-omni.equivalence-assessment.v1" },
    "assessment_id": { "$ref": "#/$defs/stableId" },
    "run_id": { "$ref": "#/$defs/stableId" },
    "scope_id": { "$ref": "#/$defs/stableId" },
    "left_profile": { "$ref": "#/$defs/profileRef" },
    "right_profile": { "$ref": "#/$defs/profileRef" },
    "direction": {
      "enum": [
        "bidirectional",
        "left_substitutes_right",
        "right_substitutes_left",
        "none",
        "unknown"
      ]
    },
    "candidate_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exact_profile_hash",
          "canonical_definition_hash",
          "dimension_signature",
          "lineage_overlap",
          "consumer_overlap",
          "repository_mapping",
          "bounded_query",
          "specialist_interpretation",
          "human_statement"
        ]
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/dimensionAssessment" }
    },
    "overall_category": {
      "enum": [
        "exact_definition",
        "structurally_equivalent",
        "bounded_behavioral_equivalence",
        "different",
        "unknown"
      ]
    },
    "overall_confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "hard_vetoes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/veto" }
    },
    "consumer_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_consumer_ids", "right_consumer_ids", "preserved_consumer_ids", "lost_consumer_ids"],
      "properties": {
        "left_consumer_ids": { "$ref": "#/$defs/stringList" },
        "right_consumer_ids": { "$ref": "#/$defs/stringList" },
        "preserved_consumer_ids": { "$ref": "#/$defs/stringList" },
        "lost_consumer_ids": { "$ref": "#/$defs/stringList" }
      }
    },
    "consumer_map_hash": { "$ref": "#/$defs/sha256" },
    "validation_context": { "$ref": "#/$defs/validationContext" },
    "proposal_only": { "const": true },
    "authorizes_consolidation": { "const": false },
    "assessment_hash": { "$ref": "#/$defs/sha256" },
    "immutable": { "const": true },
    "provenance": { "type": "object" },
    "security": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_category": {
            "enum": ["exact_definition", "structurally_equivalent"]
          }
        },
        "required": ["overall_category"]
      },
      "then": {
        "properties": {
          "hard_vetoes": { "maxItems": 0 },
          "consumer_scope": {
            "properties": { "lost_consumer_ids": { "maxItems": 0 } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "overall_category": { "const": "bounded_behavioral_equivalence" } },
        "required": ["overall_category"]
      },
      "then": {
        "properties": {
          "candidate_methods": { "contains": { "const": "bounded_query" } }
        }
      }
    },
    {
      "if": {
        "properties": { "hard_vetoes": { "minItems": 1 } },
        "required": ["hard_vetoes"]
      },
      "then": {
        "properties": {
          "overall_category": { "enum": ["different", "unknown"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation_context": {
            "properties": {
              "inventory_closure": {
                "properties": { "status": { "const": "incomplete" } },
                "required": ["status"]
              }
            },
            "required": ["inventory_closure"]
          }
        },
        "required": ["validation_context"]
      },
      "then": {
        "properties": {
          "hard_vetoes": { "contains": { "const": "dependency_closure_incomplete" } }
        }
      }
    },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "definition" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "grain" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "lineage" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "aggregation" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "filters" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "joins" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "time" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "security" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "operations" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "consumers" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "dimensions": { "contains": { "properties": { "dimension": { "const": "side_effects" } }, "required": ["dimension"] }, "minContains": 1, "maxContains": 1 } } }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonSecretRef": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?!secret:|vault:|credential:)[A-Za-z][A-Za-z0-9+.-]*:.+$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "asset_id", "profile_hash", "dimension_hashes"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/stableId" },
        "asset_id": { "$ref": "#/$defs/nonEmptyString" },
        "profile_hash": { "$ref": "#/$defs/sha256" },
        "dimension_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "grain",
            "lineage",
            "aggregation",
            "filters",
            "joins",
            "time",
            "security",
            "operations",
            "consumers",
            "side_effects"
          ],
          "properties": {
            "definition": { "$ref": "#/$defs/sha256" },
            "grain": { "$ref": "#/$defs/sha256" },
            "lineage": { "$ref": "#/$defs/sha256" },
            "aggregation": { "$ref": "#/$defs/sha256" },
            "filters": { "$ref": "#/$defs/sha256" },
            "joins": { "$ref": "#/$defs/sha256" },
            "time": { "$ref": "#/$defs/sha256" },
            "security": { "$ref": "#/$defs/sha256" },
            "operations": { "$ref": "#/$defs/sha256" },
            "consumers": { "$ref": "#/$defs/sha256" },
            "side_effects": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "artifactRevisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_hash", "revision"],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/nonSecretRef" },
        "artifact_hash": { "$ref": "#/$defs/sha256" },
        "revision": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "inventoryClosureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_hash", "revision", "status"],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/nonSecretRef" },
        "artifact_hash": { "$ref": "#/$defs/sha256" },
        "revision": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["complete", "incomplete"] }
      }
    },
    "validationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_closure",
        "source_graph",
        "portfolio_inventory",
        "repository_inventory",
        "target_context",
        "policy_bundle",
        "approval_owner_policy",
        "fixture_bundle",
        "consumer_contract_set",
        "context_hash"
      ],
      "properties": {
        "inventory_closure": { "$ref": "#/$defs/inventoryClosureRef" },
        "source_graph": { "$ref": "#/$defs/artifactRevisionRef" },
        "portfolio_inventory": { "$ref": "#/$defs/artifactRevisionRef" },
        "repository_inventory": { "$ref": "#/$defs/artifactRevisionRef" },
        "target_context": { "$ref": "#/$defs/artifactRevisionRef" },
        "policy_bundle": { "$ref": "#/$defs/artifactRevisionRef" },
        "approval_owner_policy": { "$ref": "#/$defs/artifactRevisionRef" },
        "fixture_bundle": { "$ref": "#/$defs/artifactRevisionRef" },
        "consumer_contract_set": { "$ref": "#/$defs/artifactRevisionRef" },
        "context_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "dimensionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "required",
        "verdict",
        "confidence",
        "evidence_methods",
        "evidence_refs",
        "counterevidence",
        "constraints"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "definition",
            "grain",
            "lineage",
            "aggregation",
            "filters",
            "joins",
            "time",
            "security",
            "operations",
            "consumers",
            "side_effects"
          ]
        },
        "required": { "type": "boolean" },
        "verdict": {
          "enum": [
            "exact",
            "equivalent_with_constraints",
            "different",
            "unknown",
            "not_applicable"
          ]
        },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "evidence_methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity_hash",
              "canonical_definition",
              "dimension_hash",
              "bounded_query",
              "specialist_interpretation",
              "human_statement"
            ]
          }
        },
        "evidence_refs": { "$ref": "#/$defs/stringList" },
        "counterevidence": { "$ref": "#/$defs/stringList" },
        "constraints": { "$ref": "#/$defs/stringList" }
      }
    },
    "veto": {
      "enum": [
        "definition_incomplete",
        "dependency_closure_incomplete",
        "grain_unknown_or_incompatible",
        "key_unknown_or_incompatible",
        "cardinality_unknown_or_incompatible",
        "fanout_failed_or_unknown",
        "aggregation_context_mismatch",
        "filter_context_mismatch",
        "time_semantics_mismatch",
        "null_or_distinct_semantics_mismatch",
        "security_domain_mismatch",
        "pdp_or_masking_mismatch",
        "derived_field_leakage_risk",
        "freshness_or_history_mismatch",
        "owner_or_sla_missing",
        "side_effects_present",
        "profile_revision_stale",
        "consumer_behavior_lost"
      ]
    }
  }
}
