{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omni-migration-agent/contracts/qa-result.v2.schema.json",
  "title": "Terminal independent Domo-to-Omni QA result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tenant_ref",
    "run_id",
    "scope_id",
    "wave_id",
    "migration_unit_id",
    "validation_cycle_id",
    "evidence_class",
    "qa_result_id",
    "result_ref",
    "case_id",
    "dimension",
    "fixture_ref",
    "fixture_hash",
    "verifier_ref",
    "producer_refs",
    "source_observation",
    "target_observation",
    "source_context",
    "target_context",
    "outcome",
    "checks",
    "observed_persona_access",
    "derived_field_leakage_detected",
    "observed_consolidation_outcome",
    "evidence_refs",
    "blockers",
    "executed_at",
    "result_hash",
    "authorizes_tenant_acceptance",
    "authorizes_production_readiness",
    "authorizes_promotion",
    "authorizes_cutover",
    "authorizes_decommissioning",
    "immutable"
  ],
  "properties": {
    "contract_version": { "const": "domo-to-omni.qa-result.v2" },
    "tenant_ref": { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
    "run_id": { "$ref": "common-definitions.v1.schema.json#/$defs/stableId" },
    "scope_id": { "$ref": "common-definitions.v1.schema.json#/$defs/stableId" },
    "wave_id": { "$ref": "common-definitions.v1.schema.json#/$defs/stableId" },
    "migration_unit_id": { "$ref": "common-definitions.v1.schema.json#/$defs/stableId" },
    "validation_cycle_id": { "$ref": "common-definitions.v1.schema.json#/$defs/stableId" },
    "evidence_class": { "$ref": "qa-fixture.v2.schema.json#/$defs/evidenceClass" },
    "qa_result_id": { "$ref": "common-definitions.v1.schema.json#/$defs/stableId" },
    "result_ref": { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
    "case_id": { "$ref": "common-definitions.v1.schema.json#/$defs/stableId" },
    "dimension": { "$ref": "qa-fixture.v2.schema.json#/$defs/coverageDimension" },
    "fixture_ref": { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
    "fixture_hash": { "$ref": "common-definitions.v1.schema.json#/$defs/sha256" },
    "verifier_ref": {
      "type": "string",
      "minLength": 4,
      "maxLength": 2048,
      "pattern": "^(agent-ref|human-ref|person-ref|person):.+$"
    },
    "producer_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" }
    },
    "source_observation": { "$ref": "qa-fixture.v2.schema.json#/$defs/artifactObservation" },
    "target_observation": { "$ref": "qa-fixture.v2.schema.json#/$defs/artifactObservation" },
    "source_context": { "$ref": "qa-fixture.v2.schema.json#/$defs/comparisonContext" },
    "target_context": { "$ref": "qa-fixture.v2.schema.json#/$defs/comparisonContext" },
    "outcome": { "enum": ["passed", "failed", "blocked", "not_run"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resultCheck" }
    },
    "observed_persona_access": {
      "oneOf": [
        { "enum": ["allow", "deny"] },
        { "type": "null" }
      ]
    },
    "derived_field_leakage_detected": { "type": "boolean" },
    "observed_consolidation_outcome": {
      "oneOf": [
        { "enum": ["exact", "equivalent", "different", "unknown"] },
        { "type": "null" }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common-definitions.v1.schema.json#/$defs/nonEmptyString" }
    },
    "executed_at": { "type": "string", "format": "date-time" },
    "result_hash": { "$ref": "common-definitions.v1.schema.json#/$defs/sha256" },
    "authorizes_tenant_acceptance": { "const": false },
    "authorizes_production_readiness": { "const": false },
    "authorizes_promotion": { "const": false },
    "authorizes_cutover": { "const": false },
    "authorizes_decommissioning": { "const": false },
    "immutable": { "const": true }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "passed" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "checks": {
            "items": { "properties": { "outcome": { "const": "passed" } } }
          },
          "evidence_refs": { "minItems": 1 },
          "blockers": { "maxItems": 0 },
          "derived_field_leakage_detected": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "failed" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": { "outcome": { "const": "failed" } },
              "required": ["outcome"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "enum": ["blocked", "not_run"] } },
        "required": ["outcome"]
      },
      "then": { "properties": { "blockers": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": { "dimension": { "const": "security_allow" }, "outcome": { "const": "passed" } },
        "required": ["dimension", "outcome"]
      },
      "then": { "properties": { "observed_persona_access": { "const": "allow" } } }
    },
    {
      "if": {
        "properties": { "dimension": { "enum": ["security_deny", "derived_field_leakage"] }, "outcome": { "const": "passed" } },
        "required": ["dimension", "outcome"]
      },
      "then": { "properties": { "observed_persona_access": { "const": "deny" } } }
    },
    {
      "if": {
        "properties": { "dimension": { "const": "negative_consolidation_control" }, "outcome": { "const": "passed" } },
        "required": ["dimension", "outcome"]
      },
      "then": {
        "properties": {
          "observed_consolidation_outcome": { "enum": ["different", "unknown"] }
        }
      }
    },
    {
      "if": {
        "properties": { "dimension": { "enum": ["security_allow", "security_deny", "derived_field_leakage"] }, "outcome": { "const": "failed" } },
        "required": ["dimension", "outcome"]
      },
      "then": { "properties": { "observed_persona_access": { "enum": ["allow", "deny"] } } }
    },
    {
      "if": {
        "properties": { "dimension": { "const": "negative_consolidation_control" }, "outcome": { "const": "failed" } },
        "required": ["dimension", "outcome"]
      },
      "then": { "properties": { "observed_consolidation_outcome": { "type": "string" } } }
    },
    {
      "if": {
        "properties": { "evidence_class": { "const": "production" } },
        "required": ["evidence_class"]
      },
      "then": {
        "properties": {
          "target_observation": {
            "allOf": [
              { "$ref": "qa-fixture.v2.schema.json#/$defs/artifactObservation" },
              {
                "properties": { "environment_tier": { "const": "production" } },
                "required": ["environment_tier"]
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "resultCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "dimension",
        "expected_ref",
        "actual_ref",
        "outcome",
        "difference_hash",
        "evidence_refs"
      ],
      "properties": {
        "check_id": { "$ref": "common-definitions.v1.schema.json#/$defs/stableId" },
        "dimension": { "$ref": "qa-fixture.v2.schema.json#/$defs/coverageDimension" },
        "expected_ref": { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
        "actual_ref": { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" },
        "outcome": { "enum": ["passed", "failed", "blocked", "not_run"] },
        "difference_hash": {
          "oneOf": [
            { "$ref": "common-definitions.v1.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "common-definitions.v1.schema.json#/$defs/nonSecretRef" }
        }
      }
    }
  }
}
