#!/bin/sh
# Explicitly enable this repository hook with: git config --local core.hooksPath .githooks
set -eu
repo_root=$(git rev-parse --show-toplevel)
if [ ! -x "$repo_root/.venv/bin/python" ]; then
  printf '%s\n' 'Security gate blocked: install the reviewed local environment before committing.' >&2
  exit 1
fi
exec "$repo_root/.venv/bin/python" "$repo_root/scripts/security_gate.py" --root "$repo_root" --staged
